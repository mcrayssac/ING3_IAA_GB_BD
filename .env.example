# Copy this file to .env and set PG_PASSWORD. .env is not committed.
# These are the local profile values of the configuration table in
# docs/architecture.md. Docker Compose reads S3_ACCESS_KEY, S3_SECRET_KEY,
# S3_BUCKET, PG_DATABASE, PG_USER, PG_PASSWORD, and PG_SCHEMA from .env, and
# replaces SPARK_MASTER, S3_ENDPOINT, and PG_HOST with the cluster profile
# service names inside its network.

TAXI_MONTHS=2026-05,2026-06,2026-07
SPARK_MASTER=local[*]
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=nyc-taxi
RAW_DIR=data/raw
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=nyc_taxi
PG_USER=nyc_taxi
PG_PASSWORD=
PG_SCHEMA=dw
